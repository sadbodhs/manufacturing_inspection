name: "inspect_bls"
backend: "python"
max_batch_size: 0
input [
  { name: "images" data_type: TYPE_FP32 dims: [ 1, 3, 640, 640 ] },
  { name: "boxes" data_type: TYPE_FP32 dims: [ -1, 4 ] }
]
output [
  { name: "score" data_type: TYPE_FP32 dims: [ -1, 1 ] },
  { name: "ndet" data_type: TYPE_INT32 dims: [ 1 ] }
]
# Four Python instances so several cameras' frames can be in flight at once
# (one Python instance runs one request at a time).
instance_group [ { count: 4 kind: KIND_GPU } ]
# Keep the frame on the GPU: without this the Python backend copies inputs to host.
parameters: { key: "FORCE_CPU_ONLY_INPUT_TENSORS" value: { string_value: "no" } }
